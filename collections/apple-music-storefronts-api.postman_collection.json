    "_postman_id": "0d5ef906-8d88-4f4e-939f-e30da9391389",
    "name": "Apple Music Catalog Storefronts API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Apple Music catalog and the authenticated user's library.\nCatalog endpoints (songs, albums, artists, music videos, playlists,\nstations, search, charts) require an Apple Developer JWT in the\nAuthorization header. User-library endpoints additionally require a\nMusic User Token in the Music-User-Token header.\n\n\nContact Support:\n Name: Apple Developer Documentation",
      "type": "text/plain"
    }
  }
